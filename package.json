{
  "name": "ventus",
  "version": "0.0.0",
  "private": true,
  "description": "Ventus open-source packages monorepo",
  "homepage": "https://github.com/ventus-software-solutions/ventus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ventus-software-solutions/ventus.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@9.15.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.11",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.1.6",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.6"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.25.0",
      "vite": "^7.0.0"
    }
  }
}
